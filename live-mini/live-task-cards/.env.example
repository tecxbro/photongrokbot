# Generate local secrets with: npm run init
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3000
PUBLISHER_TOKEN=replace-with-at-least-32-random-characters
VIEW_SIGNING_SECRET=replace-with-another-32-random-characters
STORE=file
DATA_FILE=.data/cards.json
# Vercel requires STORE=redis. Never use its temporary filesystem as persistence.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY=live-task-cards:v1:my-setup
# Read-only history: explicit product defaults, not platform limits.
ARCHIVE_DAYS=30
MAX_ARCHIVED_CARDS=100
# No public examples in production unless explicitly enabled.
ENABLE_DEMOS=false
