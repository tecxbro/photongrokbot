# Empty reference only: setup preserves existing files and writes missing values
# to $PHOTON_INSTANCE_DIR/secrets/bridge.env (0600), never into the checkout.
# Default PHOTON_INSTANCE_DIR is /workspace/photongrokbot-state.
# Set PHOTON_INSTANCE_DIR in the launcher environment, not inside this file.
# Spectrum Cloud project credentials (NOT the Photon CLI token).

SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Exact Photon sender id allowed to talk to this proof (E.164 or Apple ID email).
AUTHORIZED_SENDER_ID=

# Orchestrator webhook. Body is only {"batchId":"..."}.
GROK_ORCHESTRATOR_WEBHOOK_URL=
GROK_ORCHESTRATOR_WEBHOOK_KEY=
